* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: Arial, sans-serif;
  background: #111827;
  color: white;
}

#drum-machine {
  width: 90%;
  max-width: 650px;
  padding: 35px;
  border-radius: 24px;
  background: #1f2937;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  text-align: center;
}

header h1 {
  margin: 0;
  font-size: 2.5rem;
  letter-spacing: 5px;
}

header p {
  margin-top: 8px;
  color: #9ca3af;
}

#display {
  min-height: 50px;
  margin: 25px 0;
  padding: 15px;
  border-radius: 12px;
  background: #111827;
  color: #38bdf8;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

#pad-bank {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.drum-pad {
  position: relative;
  min-height: 110px;
  border: none;
  border-radius: 16px;
  background: #374151;
  color: white;
  font-size: 2rem;
  font-weight: bold;
  cursor: pointer;
  transition: 0.15s;
  box-shadow: 0 6px 0 #111827;
}

.drum-pad:hover {
  background: #4b5563;
}

.drum-pad:active,
.drum-pad.active {
  transform: translateY(5px);
  box-shadow: 0 1px 0 #111827;
  background: #0ea5e9;
}

@media (max-width: 500px) {
  #drum-machine {
    padding: 20px;
  }

  header h1 {
    font-size: 1.8rem;
  }

  .drum-pad {
    min-height: 85px;
  }
}
